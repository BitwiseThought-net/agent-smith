# --- CORE CONFIG ---

# Model selection
MODEL_NAME=qwen3.6:latest

# --- PORTS ---
LITELLM_PORT=4000
UI_PORT=3000

# --- BOOT SECURITY ---
WEBUI_SECRET_KEY=
ENABLE_SIGNUP=false

# --- DOCKER NETWORKING ---
OLLAMA_BASE_URL=http://ai-ollama:11434
LITELLM_BASE_URL=http://ai-litellm:4000/v1

# --- NOTIFICATIONS ---
NOTIFY_WEBHOOK_URL="https://discord.com/api/webhooks/1503211475358191777/fliQuhH5S8Wa-XlZX6Qd9CgRBYg8AApJIGeFzzhf4_tHMl0KlM1nNwymdCoPtu0G9rYh"

OLLAMA_PORT=11434
LITELLM_MASTER_KEY=
ENABLE_RAG_WEB_SEARCH=true
RAG_WEB_SEARCH_ENGINE

SEARXNG_QUERY_URL="http://searxng:8080/search?q=<query>"


# Read the documentation before using the `docker-compose.yml` file:
# https://docs.searxng.org/admin/installation-docker.html
#
# Additional ENVs:
# https://docs.searxng.org/admin/settings/settings_general.html#settings-general
# https://docs.searxng.org/admin/settings/settings_server.html#settings-server

# Use a specific version tag. E.g. "latest" or "2026.3.25-541c6c3cb".
#SEARXNG_VERSION=latest
SEARXNG_VERSION=latest

# Listen to a specific address.
#SEARXNG_HOST=[::]
#SEARXNG_HOST=[::]

# Listen to a specific port.
SEARXNG_PORT=8080
#SEARXNG_PORT=7412

# Account the tool-installer service will create (or sign into) as the first
# Open WebUI admin, and under which it installs the two Tools automatically.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

OLLAMA_CONTEXT_LENGTH=65536



